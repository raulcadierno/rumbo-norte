---
// DestinationsGrid.astro - Grid de destinos optimizado según reglas del proyecto
import { Image } from 'astro:assets';

// Definición TypeScript para datos de destinos (No hardcoded)
interface Destination {
  id: string;
  title: string;
  description: string;
  image: string;
  alt: string;
  href: string;
}

const destinations: Destination[] = [
  {
    id: 'brasil',
    title: 'Brasil: Selva y Playas',
    description: 'Descubre la biodiversidad de la Amazonía profunda y las paradisíacas costas de Bahía en una experiencia única.',
    image: 'https://images.unsplash.com/photo-1483729558449-99ef09a8c325?q=80&w=2070&auto=format&fit=crop',
    alt: 'Selva amazónica de Brasil con río serpenteante y exuberante vegetación verde',
    href: '/destinos/brasil'
  },
  {
    id: 'islandia',
    title: 'Islandia: Tierra de Hielo y Fuego',
    description: 'Explora glaciares milenarios, géiseres humeantes y la magia de la aurora boreal en el país más salvaje de Europa.',
    image: 'https://images.unsplash.com/photo-1506905925346-21bda4d32df4?q=80&w=2070&auto=format&fit=crop',
    alt: 'Paisaje islandés con montañas nevadas, géiser y cielo dramático',
    href: '/destinos/islandia'
  }
];

export interface Props {
  title?: string;
  subtitle?: string;
  description?: string;
}

const {
  title = "Nuestros Destinos",
  subtitle = "EXPLORA",
  description = "Seleccionamos cuidadosamente cada ruta para ofrecerte una experiencia auténtica y transformadora."
} = Astro.props;
---

<!-- Sección de destinos con fondo oscuro -->
<section class="bg-slate-950 py-20 lg:py-32">
  <div class="container mx-auto px-4">
    
    <!-- Header: Estructura vertical -->
    <div class="w-full mb-12">
      
      <!-- Label azul -->  
      <p class="text-blue-400 text-sm font-medium tracking-wider uppercase mb-4">
        {subtitle}
      </p>
      
      <!-- Título principal -->
      <h2 class="text-4xl lg:text-5xl xl:text-6xl font-bold text-white leading-tight mb-6">
        {title}
      </h2>
      
      <!-- Texto descriptivo con ancho limitado -->
      <p class="text-slate-400 text-lg lg:text-xl leading-relaxed max-w-2xl">
        {description}
      </p>
      
    </div>

    <!-- Grid de tarjetas de destinos -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
      {destinations.map((destination) => (
        <a 
          href={destination.href}
          class="destination-card group relative aspect-4/5 rounded-2xl overflow-hidden hover:scale-[1.02] transition-transform duration-300 cursor-pointer"
          data-astro-prefetch
          aria-label={`Explorar destino ${destination.title}`}
        >
          
          <!-- Imagen de fondo optimizada -->
          <div class="destination-image-container absolute inset-0 overflow-hidden">
            <Image
              src={destination.image}
              alt={destination.alt}
              class="destination-image w-full h-full object-cover scale-100 transition-transform duration-700 group-hover:scale-110"
              quality="high"
              loading="lazy"
              width={640}
              height={500}
              format="webp"
            />
          </div>
          
          <!-- Overlay degradado para legibilidad -->
          <div class="absolute inset-0 bg-linear-to-t from-black/80 via-black/20 to-transparent transition-colors duration-700 group-hover:from-black/90 group-hover:via-black/40"></div>
          
          <!-- Contenido de la tarjeta (parte inferior) -->
          <div class="absolute bottom-0 left-0 right-0 p-8">
            <div class="space-y-4">
              
              <!-- Título del destino -->
              <h3 class="destination-title text-2xl lg:text-3xl font-bold text-white leading-tight">
                {destination.title}
              </h3>
              
              <!-- Descripción (responsive: oculta en móvil/tablet, visible en desktop) -->
              <p class="text-gray-200 leading-relaxed hidden lg:block">
                {destination.description}
              </p>
              
              <!-- Indicador clickeable -->
              <div class="pt-2">
                <div class="destination-cta inline-flex items-center space-x-2 text-blue-400 font-medium transition-colors duration-200 group-hover:translate-x-1 group-hover:text-blue-300">
                  <span>Explorar destino</span>
                  
                  <!-- Icono flecha derecha -->
                  <svg 
                    class="w-5 h-5 transition-transform duration-200 group-hover:translate-x-1" 
                    fill="none" 
                    stroke="currentColor" 
                    viewBox="0 0 24 24"
                    aria-hidden="true"
                  >
                    <path 
                      stroke-linecap="round" 
                      stroke-linejoin="round" 
                      stroke-width="2" 
                      d="M17 8l4 4m0 0l-4 4m4-4H3"
                    />
                  </svg>
                </div>
              </div>
              
            </div>
          </div>
          
        </a>
      ))}
    </div>
    
  </div>
</section>

<style>
  /* Optimizaciones adicionales */
  article {
    /* Mejorar rendering de imágenes */
    will-change: transform;
    transform: translateZ(0);
  }
  
  /* Hover effect suave para enlaces */
  a:hover {
    text-shadow: 0 0 12px currentColor;
  }
  
  /* Asegurar contraste en texto */
  h3, p {
    text-shadow: 0 2px 8px rgba(0, 0, 0, 0.7);
  }
  
  /* Responsive fine-tuning */
  @media (max-width: 640px) {
    .container {
      padding-left: 1rem;
      padding-right: 1rem;
    }
  }
</style>
