---
// DestinationsGrid.astro - Grid de destinos optimizado según reglas del proyecto
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import type { ImageMetadata } from 'astro';

import brasilImg from '../assets/viajes/brasil/brasil.jpg';
import islandiaImg from '../assets/viajes/islandia/islandia.jpg';

const imageMap: Record<string, ImageMetadata> = {
  brasil: brasilImg,
  islandia: islandiaImg,
};

const viajesRaw = await getCollection('viajes');

// Un único destino por slug canónico (excluir entradas de routeId alias)
const seen = new Set<string>();
const destinations = viajesRaw
  .filter((v) => {
    if (seen.has(v.id)) return false;
    seen.add(v.id);
    return true;
  })
  .map((v) => ({
    id: v.id,
    title: v.data.title,
    description: v.data.description,
    image: imageMap[v.id] ?? islandiaImg,
    href: `./viajes/${v.id}`,
  }));

export interface Props {
  title?: string;
  subtitle?: string;
  description?: string;
}

const {
  title = "Nuestros Destinos",
  subtitle = "EXPLORA",
  description = "Seleccionamos cuidadosamente cada ruta para ofrecerte una experiencia auténtica y transformadora."
} = Astro.props;
---

<!-- Sección de destinos con fondo oscuro -->
<section class="bg-nomad-bg pt-10 pb-14 lg:pt-14 lg:pb-20">
  <div class="container mx-auto px-4">
    
    <!-- Header: Estructura vertical -->
    <div class="w-full mb-8 lg:mb-10">
      
      <!-- Label azul -->  
      <p class="font-sans text-nomad-cta text-sm font-medium tracking-wider uppercase mb-3">
        {subtitle}
      </p>
      
      <!-- Título principal -->
      <h2 class="font-display text-4xl lg:text-5xl xl:text-6xl font-extrabold tracking-tight text-nomad-text-main leading-tight mb-4">
        {title}
      </h2>
      
      <!-- Texto descriptivo con ancho limitado -->
      <p class="font-sans font-normal text-stone-600 text-base lg:text-lg leading-relaxed max-w-2xl">
        {description}
      </p>
      
    </div>

    <!-- Grid de tarjetas de destinos -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      {destinations.map((destination) => (
        <a 
          href={destination.href}
          class="destination-card group relative aspect-[5/6] md:aspect-[4/5] rounded-2xl overflow-hidden hover:scale-[1.02] transition-transform duration-300 cursor-pointer"
          data-astro-prefetch
          aria-label={`Explorar destino ${destination.title}`}
        >
          
          <!-- Imagen de fondo optimizada -->
          <div class="destination-image-container absolute inset-0 overflow-hidden">
            <Image
              src={destination.image}
              alt={destination.title}
              class="destination-image w-full h-full object-cover scale-100 transition-transform duration-700 group-hover:scale-110"
              quality="high"
              loading="lazy"
              width={640}
              height={500}
              format="webp"
            />
          </div>
          
          <!-- Overlay degradado para legibilidad -->
          <div class="absolute inset-0 bg-linear-to-t from-black/80 via-black/20 to-transparent transition-colors duration-700 group-hover:from-black/90 group-hover:via-black/40"></div>
          
          <!-- Contenido de la tarjeta (parte inferior) -->
          <div class="absolute bottom-0 left-0 right-0 p-6 lg:p-7">
            <div class="space-y-3">
              
              <!-- Título del destino -->
              <h3 class="destination-title font-display text-xl lg:text-2xl font-bold tracking-tight text-white leading-tight">
                {destination.title}
              </h3>
              
              <!-- Descripción (responsive: oculta en móvil/tablet, visible en desktop) -->
              <p class="font-sans font-normal text-sm text-gray-200 leading-relaxed hidden lg:block">
                {destination.description}
              </p>
              
              <!-- Indicador clickeable -->
              <div class="pt-1">
                <div class="destination-cta inline-flex items-center space-x-2 text-sm text-nomad-cta font-medium transition-colors duration-200 group-hover:translate-x-1 group-hover:text-nomad-cta-hover">
                  <span class="font-sans font-medium">Explorar destino</span>
                  
                  <!-- Icono flecha derecha -->
                  <svg 
                    class="w-4 h-4 transition-transform duration-200 group-hover:translate-x-1" 
                    fill="none" 
                    stroke="currentColor" 
                    viewBox="0 0 24 24"
                    aria-hidden="true"
                  >
                    <path 
                      stroke-linecap="round" 
                      stroke-linejoin="round" 
                      stroke-width="2" 
                      d="M17 8l4 4m0 0l-4 4m4-4H3"
                    />
                  </svg>
                </div>
              </div>
              
            </div>
          </div>
          
        </a>
      ))}
    </div>
    
  </div>
</section>

<style>
  /* Optimizaciones adicionales */
  article {
    /* Mejorar rendering de imágenes */
    will-change: transform;
    transform: translateZ(0);
  }
  
  /* Hover effect suave para enlaces */
  a:hover {
    text-shadow: 0 0 12px currentColor;
  }
  
  /* Asegurar contraste en texto */
  h3, p {
    text-shadow: 0 2px 8px rgba(0, 0, 0, 0.7);
  }
  
  /* Responsive fine-tuning */
  @media (max-width: 640px) {
    .container {
      padding-left: 1rem;
      padding-right: 1rem;
    }
  }
</style>
