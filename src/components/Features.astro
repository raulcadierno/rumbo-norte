---
import { Image } from 'astro:assets';

interface FeatureItem {
  title: string;
  description: string;
  icon: 'compass' | 'shield' | 'leaf';
}

const features: FeatureItem[] = [
  {
    icon: 'compass',
    title: 'Guias Expertos',
    description:
      'Nuestro equipo esta formado por profesionales apasionados con anos de experiencia en el terreno, conocedores de cada rincon secreto.'
  },
  {
    icon: 'shield',
    title: 'Seguridad Primero',
    description:
      'Priorizamos tu bienestar con protocolos de seguridad rigurosos y equipamiento de primera calidad en todas nuestras expediciones.'
  },
  {
    icon: 'leaf',
    title: 'Turismo Sostenible',
    description:
      'Estamos comprometidos con la preservacion del entorno y el apoyo a las economias locales, minimizando nuestra huella de carbono.'
  }
];
---

<section class="bg-slate-950 py-20 lg:py-32">
  <div class="container mx-auto px-4">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">
      <div>
        <p class="text-emerald-400 text-sm font-semibold tracking-wider uppercase mb-4">
          DIFERENCIADORES
        </p>

        <h2 class="text-4xl lg:text-5xl font-bold text-white leading-tight mb-10">
          ¿Por que viajar con nosotros?
        </h2>

        <div class="space-y-8">
          {features.map((feature) => (
            <article class="flex items-start gap-4">
              <div class="shrink-0 w-12 h-12 rounded-full bg-blue-950/90 border border-blue-800/70 text-blue-300 flex items-center justify-center" aria-hidden="true">
                {feature.icon === 'compass' && (
                  <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M10.5 13.5l3-3m0 0l-2.2 6.2-6.3 2.2 2.2-6.3 6.3-2.1z" />
                    <circle cx="12" cy="12" r="9" stroke-width="1.8" />
                  </svg>
                )}

                {feature.icon === 'shield' && (
                  <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M12 3l7 3v5c0 5-3.2 8.4-7 10-3.8-1.6-7-5-7-10V6l7-3z" />
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M9.5 12.5l1.7 1.7 3.3-3.7" />
                  </svg>
                )}

                {feature.icon === 'leaf' && (
                  <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M5 14c0-5.5 4.6-10 10-10 1.7 0 3 .2 4 .6-.3 1-.6 2.3-.6 4 0 5.4-4.5 10-10 10-1.2 0-2.3-.2-3.4-.6" />
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M8 16c2-2 4.7-4 8-5.5" />
                  </svg>
                )}
              </div>

              <div>
                <h3 class="text-white font-semibold text-xl mb-2">{feature.title}</h3>
                <p class="text-slate-300 leading-relaxed">{feature.description}</p>
              </div>
            </article>
          ))}
        </div>
      </div>

      <div>
        <Image
          src="https://images.unsplash.com/photo-1472396961693-142e6e269027?q=80&w=1800&auto=format&fit=crop"
          alt="Montanas de la Patagonia al amanecer con cielo dramatico y valle profundo"
          class="w-full h-full max-h-140 object-cover rounded-3xl shadow-xl shadow-black/40"
          quality="high"
          loading="lazy"
          width={1200}
          height={1600}
          format="webp"
        />
      </div>
    </div>
  </div>
</section>
