---
export interface GalleryImage {
  src: string;
  alt: string;
}

export interface Props {
  images: GalleryImage[];
}

const { images = [] } = Astro.props as Props;
const doubledImages = [...images, ...images];
---

<section>
  <div class="gallery-marquee w-full overflow-hidden bg-brand-bg py-8 md:py-12">
        <div class="animate-marquee flex w-max gap-0">
            {doubledImages.map((image, index) => (
            <img
                src={image.src}
                alt={image.alt}
                class="h-64 md:h-80 w-auto object-cover shrink-0 transition-transform duration-300 ease-out hover:scale-120"
                loading="lazy"
                decoding="async"
                aria-hidden={index >= images.length ? 'true' : 'false'}
            />
            ))}
        </div>
    </div>
</section>

<style>
  @keyframes marquee {
    0% {
      transform: translateX(0%);
    }
    100% {
      transform: translateX(-50%);
    }
  }

  .animate-marquee {
    animation: marquee 60s linear infinite;
  }

  .gallery-marquee:hover .animate-marquee {
    animation-play-state: paused;
  }
</style>
