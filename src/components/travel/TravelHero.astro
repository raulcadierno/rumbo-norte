---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

export interface Props {
  title: string;
  subtitle: string;
  description: string;
  image: ImageMetadata;
  videoSrc?: string | null;
  posterSrc?: string;
  accentColor?: string;
}

const { title, subtitle, description, image, videoSrc, posterSrc, accentColor = 'var(--color-cta, #C4A484)' } = Astro.props as Props;
---

<section class="relative h-screen flex flex-col justify-center items-center">
  {videoSrc ? (
    <video
      autoplay
      muted
      loop
      playsinline
      poster={posterSrc ?? image.src}
      class="absolute inset-0 w-full h-full object-cover z-0"
      aria-label={title}
    >
      <source src={videoSrc} type="video/webm" />
    </video>
  ) : (
    <div class="absolute inset-0 z-0">
      <Image
        src={image}
        alt={title}
        class="w-full h-full object-cover"
        quality="high"
        loading="eager"
        width={1920}
        height={1080}
        format="webp"
      />
    </div>
  )}

  <div class="absolute inset-0 bg-black/40 z-10"></div>

  <div class="relative z-20 text-center px-4 max-w-4xl">

    <h1 class="font-display text-white/95 text-5xl md:text-7xl lg:text-8xl font-extrabold tracking-tight leading-tight mb-6">
      {title}
    </h1>

    <p class="font-sans font-normal text-white/95 text-lg md:text-xl lg:text-2xl leading-relaxed max-w-3xl mx-auto">
      {description}
    </p>
  </div>

  <div class="absolute bottom-8 left-1/2 transform -translate-x-1/2 z-20">
    <div class="flex flex-col items-center space-y-2 animate-bounce">
      <p class="font-sans text-white/70 text-xs uppercase tracking-wider font-medium">
        Desliza para explorar
      </p>
      <svg
        class="w-5 h-5 text-white/70"
        fill="none"
        stroke="currentColor"
        viewBox="0 0 24 24"
        aria-hidden="true"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          d="M19 14l-7 7m0 0l-7-7m7 7V3"
        />
      </svg>
    </div>
  </div>
</section>
