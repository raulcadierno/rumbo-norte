---
export interface Props {
  duration: string;
  groupSize: string;
  price: string;
  accentColor?: string;
}

const { duration, groupSize, price, accentColor = 'var(--color-cta, #C4A484)' } = Astro.props as Props;
---

<div class="rounded-2xl p-8 md:p-12 backdrop-blur-sm bg-brand-secondary">
  <div class="grid grid-cols-1 md:grid-cols-3 gap-8 md:gap-12">
    <div class="text-center">
      <div class="mb-4">
        <svg class="w-8 h-8 mx-auto" style={`color: ${accentColor}`} fill="currentColor" viewBox="0 0 20 20">
          <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm1-12a1 1 0 10-2 0v4a1 1 0 00.293.707l2.828 2.829a1 1 0 101.415-1.415L11 9.586V6z" clip-rule="evenodd"></path>
        </svg>
      </div>
      <p class="text-sm uppercase tracking-wider mb-2 text-brand-text-muted">Duración</p>
      <p class="text-xl font-semibold text-brand-text">{duration}</p>
    </div>

    <div class="text-center">
      <div class="mb-4">
        <svg class="w-8 h-8 mx-auto" style={`color: ${accentColor}`} fill="currentColor" viewBox="0 0 20 20">
          <path d="M9 6a3 3 0 11-6 0 3 3 0 616 0zM17 6a3 3 0 11-6 0 3 3 0 616 0zM12.93 17c.046-.327.07-.66.07-1a6.97 6.97 0 00-1.5-4.33A5 5 0 0119 16v1h-6.07zM6 11a5 5 0 515 5v1H1v-1a5 5 0 515-5z"></path>
        </svg>
      </div>
      <p class="text-sm uppercase tracking-wider mb-2 text-brand-text-muted">Grupo Reducido</p>
      <p class="text-xl font-semibold text-brand-text">{groupSize}</p>
    </div>

    <div class="text-center">
      <div class="mb-4">
        <svg class="w-8 h-8 mx-auto" style={`color: ${accentColor}`} fill="currentColor" viewBox="0 0 20 20">
          <path d="M4 4a2 2 0 00-2 2v4a2 2 0 002 2V6h10a2 2 0 00-2-2H4zm2 6a2 2 0 012-2h8a2 2 0 012 2v4a2 2 0 01-2 2H8a2 2 0 01-2-2v-4zm6 4a2 2 0 100-4 2 2 0 000 4z"></path>
        </svg>
      </div>
      <p class="text-sm uppercase tracking-wider mb-2 text-brand-text-muted">Inversión</p>
      <p class="text-xl font-semibold text-brand-text">{price}</p>
    </div>
  </div>
</div>
