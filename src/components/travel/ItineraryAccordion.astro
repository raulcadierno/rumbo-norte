---
export interface ItineraryItem {
  dayNumber?: string | number;
  title: string;
  content: string;
}

export interface Props {
  itinerary: ItineraryItem[];
}

const { itinerary = [] } = Astro.props as Props;
---

{itinerary.length > 0 && (
  <section class="bg-nomad-bg py-16 md:py-20">
    <div class="container mx-auto px-4">
      <div class="max-w-5xl mx-auto">
        {itinerary.map((item) => (
          <details name="itinerary-accordion" class="group border-b border-neutral-200 hover:bg-neutral-50 transition-colors">
            <summary class="list-none [&::-webkit-details-marker]:hidden flex items-center gap-4 px-2 py-5 cursor-pointer">
              {item.dayNumber !== undefined && item.dayNumber !== '' && (
                <span class="w-24 shrink-0 font-sans font-bold text-[#2D3436] uppercase tracking-wide">
                  DÍA {item.dayNumber}
                </span>
              )}

              <h3 class={`font-sans font-medium text-[#2D3436] leading-snug ${item.dayNumber !== undefined && item.dayNumber !== '' ? 'flex-1' : 'w-full'}`}>
                {item.title}
              </h3>

              <span
                class="shrink-0 font-sans text-2xl leading-none text-[#2D3436] transition-transform duration-300 group-open:rotate-45"
                aria-hidden="true"
              >
                +
              </span>
            </summary>

            <div class="accordion-content-grid">
              <div class="accordion-content px-2 pb-6">
                <div class="max-w-3xl font-sans font-normal text-nomad-text-muted leading-relaxed" set:html={item.content}></div>
              </div>
            </div>
          </details>
        ))}
      </div>
    </div>
  </section>
)}

<style>
  .accordion-content-grid {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows 260ms ease;
  }

  .accordion-content {
    overflow: hidden;
    opacity: 0;
    transform: translateY(-4px);
    transition: opacity 220ms ease, transform 220ms ease;
  }

  details[open] .accordion-content-grid {
    grid-template-rows: 1fr;
  }

  details[open] .accordion-content {
    opacity: 1;
    transform: translateY(0);
  }
</style>
