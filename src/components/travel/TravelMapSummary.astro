---
import { Image } from 'astro:assets';
import islandiaImg from '../../assets/viajes/islandia/islandia-map.png';
import type { ItineraryDay } from '../../utils/itineraryHelper';

export interface Props {
  itineraryDays: ItineraryDay[];
  accentColor?: string;
}

const { itineraryDays, accentColor = 'var(--color-cta, #C4A484)' } = Astro.props as Props;
---

<section class="w-full bg-brand-bg">
  <div class="w-full grid grid-cols-1 md:grid-cols-2 items-center min-h-fit">
    
    <div class="w-full flex justify-start items-center overflow-hidden">
        <Image
          src={islandiaImg}
          alt="Mapa visual del viaje"
          class="w-full h-auto max-w-full" 
          loading="lazy"
          format="webp"
          quality="high"
        />
    </div>

    <div class="w-full py-12 md:py-16 pl-8 md:pl-12 lg:pl-16 pr-4 md:pr-8 lg:pr-12">
      <div class="w-full max-w-2xl">
        <ol class="space-y-4">
          {itineraryDays.map((day, index) => (
            <li class="flex items-center gap-4 group">
              <span
                class="w-7 h-7 rounded-full shrink-0 text-sm font-bold flex items-center justify-center transition-transform group-hover:scale-110"
                style={`background-color: ${accentColor}`}
              >
                {index + 1}
              </span>
              <p class="font-sans text-base md:text-lg font-medium text-brand-text">
                {day.title}
              </p>
            </li>
          ))}
        </ol>
      </div>
    </div>

  </div>

  <div class="w-full">
    <div class="max-w-7xl mx-auto px-4 py-12 md:py-16 text-center">
      <h2 class="font-display text-3xl md:text-4xl font-extrabold tracking-tight mb-4 text-brand-text">
        ¿Quieres descubrir cada secreto de esta ruta?
      </h2>
      <span class="font-sans text-lg md:text-xl mb-10 block text-brand-text-muted">
        Explora el día a día completo de nuestra expedición.
      </span>

      <a
        href="#itinerario-detallado"
        class="inline-flex items-center px-10 py-4 rounded-full text-white font-sans font-bold uppercase tracking-wide transition-all hover:scale-105 active:scale-95"
        style={`background-color: ${accentColor}`}
      >
        ITINERARIO DETALLADO
      </a>
    </div>
  </div>
</section>