---
// NavigationMenu.astro - Componente optimizado según reglas del proyecto
export interface Props {
  transparent?: boolean;
}

const { transparent = false } = Astro.props;
---

<!-- Navbar principal con glassmorphism -->
<header id="navigation" data-navbar>
  <!-- Checkbox para menú móvil CSS-only -->
  <input type="checkbox" class="hidden" id="mobile-toggle">
  
  <nav id="global-navbar" class="fixed top-0 inset-x-0 z-50 w-full py-3 bg-linear-to-b from-black/70 via-black/30 to-transparent px-4 md:px-8 lg:px-12 transition-transform duration-300 ease-in-out" data-nav-content>
    <div class="mx-auto flex max-w-7xl items-center justify-between">
    
    <!-- Logo Section -->
    <div class="flex items-center space-x-3">
      <!-- Compass Icon SVG -->
      <svg 
        class="w-8 h-8 text-white" 
        fill="none" 
        stroke="currentColor" 
        viewBox="0 0 24 24"
        aria-hidden="true"
      >
        <circle cx="12" cy="12" r="10" />
        <polygon points="16.24,7.76 14.12,14.12 7.76,16.24 9.88,9.88 16.24,7.76" />
      </svg>
      
      <!-- Logo Text con ViewTransition -->
      <a 
        href="./" 
        class="font-display text-sm font-semibold uppercase tracking-wider text-white hover:text-white/90 transition-colors duration-200"
        data-astro-prefetch
      >
        Nomad Expeditions
      </a>
    </div>

    <!-- Desktop Navigation Links -->
    <div class="hidden md:flex items-center space-x-8">
      <a 
        href="./#destinos" 
        class="font-sans text-sm font-medium uppercase tracking-wider text-white hover:text-white/80 transition-colors duration-200"
        data-astro-prefetch
      >
        Destinos
      </a>
      <a 
        href="./#nosotros" 
        class="font-sans text-sm font-medium uppercase tracking-wider text-white hover:text-white/80 transition-colors duration-200"
        data-astro-prefetch
      >
        Nosotros
      </a>
      
      <!-- Reservar Button (Pill Style) -->
      <a 
        href="./#contacto" 
        class="bg-nomad-cta hover:bg-nomad-cta-hover text-nomad-text-main rounded-full px-6 py-2 font-sans text-sm font-semibold transition-colors duration-300"
        data-astro-prefetch
      >
        Reservar
      </a>
    </div>

    <!-- Mobile Menu Button - CSS-only -->
    <label for="mobile-toggle" class="md:hidden text-white hover:text-white/80 transition-colors duration-200 cursor-pointer">
      <!-- Hamburger Icon -->
      <svg class="w-6 h-6 mobile-icon-open" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
      </svg>
      <!-- X Icon -->
      <svg class="w-6 h-6 mobile-icon-close hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </label>
    </div>
  </nav>

  <!-- Mobile Menu -->
  <div class="md:hidden mobile-menu bg-nomad-bg/95 backdrop-blur-md border-t border-slate-900/10 shadow-lg shadow-slate-900/5">
    <div class="container mx-auto px-4 py-6 space-y-4">
      <a 
        href="./#destinos" 
        class="block font-sans text-sm font-medium uppercase tracking-wider text-white hover:text-white/80 transition-colors duration-200"
        data-astro-prefetch
      >
        Destinos
      </a>
      <a 
        href="./#nosotros" 
        class="block font-sans text-sm font-medium uppercase tracking-wider text-white hover:text-white/80 transition-colors duration-200"
        data-astro-prefetch
      >
        Nosotros
      </a>
      <a 
        href="./#contacto" 
        class="inline-block bg-nomad-cta hover:bg-nomad-cta-hover text-nomad-text-main rounded-full px-6 py-2 font-sans text-sm font-semibold transition-colors duration-300 mt-4"
        data-astro-prefetch
      >
        Reservar
      </a>
    </div>
  </div>
</header>

<script>
  const windowWithCleanup = window as Window & {
    __navbarScrollCleanup?: () => void;
  };

  function initNavbarScrollBehavior() {
    const navbar = document.getElementById('global-navbar');
    if (!navbar) return;

    let lastScrollY = window.scrollY;

    const onScroll = () => {
      const currentScrollY = window.scrollY;

      // Si el usuario hace scroll hacia abajo, escondemos la navbar
      if (currentScrollY > lastScrollY && currentScrollY > 80) {
        navbar.classList.add('-translate-y-full');
      }
      // Si hace scroll hacia arriba, la mostramos
      else {
        navbar.classList.remove('-translate-y-full');
      }

      lastScrollY = currentScrollY;
    };

    // Limpiamos un listener previo al navegar con View Transitions.
    if (windowWithCleanup.__navbarScrollCleanup) {
      windowWithCleanup.__navbarScrollCleanup();
    }

    window.addEventListener('scroll', onScroll, { passive: true });
    windowWithCleanup.__navbarScrollCleanup = () => window.removeEventListener('scroll', onScroll);

    // Estado inicial coherente al entrar en cada página.
    onScroll();
  }

  initNavbarScrollBehavior();
  document.addEventListener('astro:page-load', initNavbarScrollBehavior);
</script>

<style>
  /* Mobile menu CSS-only */
  .mobile-menu {
    max-height: 0;
    overflow: hidden;
    transition: max-height 0.3s ease-out;
  }
  
  #mobile-toggle:checked ~ nav label .mobile-icon-open {
    display: none;
  }
  
  #mobile-toggle:checked ~ nav label .mobile-icon-close {
    display: block;
  }
  
  #mobile-toggle:checked ~ .mobile-menu {
    max-height: 100vh;
  }
</style>