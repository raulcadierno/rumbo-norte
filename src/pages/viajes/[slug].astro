---
import { getCollection, type CollectionEntry } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import TravelHero from '../../components/travel/TravelHero.astro';
import QuickInfoBar from '../../components/travel/QuickInfoBar.astro';
import TravelMapSummary from '../../components/travel/TravelMapSummary.astro';
import ItinerarySection from '../../components/travel/ItinerarySection.astro';
import { getTravelData } from '../../utils/itineraryHelper';

import brasilImg from '../../assets/viajes/brasil/brasil.jpg';
import islandiaPoster from '../../assets/viajes/islandia/islandia.jpg';
import islandiaVid from '../../assets/viajes/islandia/islandia-vid.webm';

export async function getStaticPaths() {
  const viajes = (await getCollection('viajes')).filter((viaje) => viaje.id !== 'islandia');

  const paths = viajes.flatMap((viaje) => {
    const canonicalSlug = viaje.data.routeId?.trim() || viaje.id;

    if (canonicalSlug === viaje.id) {
      return [{
        params: { slug: viaje.id },
        props: { viaje }
      }];
    }

    return [
      {
        params: { slug: canonicalSlug },
        props: { viaje }
      },
      {
        params: { slug: viaje.id },
        props: { viaje }
      }
    ];
  });

  return paths;
}

interface Props {
  viaje: CollectionEntry<'viajes'>;
}

const { viaje } = Astro.props as Props;
const {
  title,
  subtitle,
  description,
  duration,
  groupSize,
  price,
  ctaButtonColor
} = viaje.data;

const { expeditionSummary, itineraryDays } = getTravelData(viaje);

const imageMap = {
  brasil: brasilImg,
  islandia: islandiaPoster
} as const;

const currentImage = imageMap[viaje.id as keyof typeof imageMap] || islandiaPoster;
const hasVideo = viaje.id === 'islandia';
const currentVideo = hasVideo ? islandiaVid : null;
const currentPoster = viaje.id === 'islandia' ? islandiaPoster : currentImage;
const accentColor = ctaButtonColor?.trim() || '#C4A484';
---

<Layout title={`${title} | Nomad Expeditions`} description={description}>
  <main data-trip-theme style={`--color-cta: ${accentColor};`}>
    <TravelHero
      title={title}
      subtitle={subtitle}
      description={description}
      image={currentImage}
      videoSrc={currentVideo}
      posterSrc={currentPoster.src}
      accentColor={accentColor}
    />

    <section class="relative py-20 bg-brand-bg">
      <div class="container mx-auto px-4">
        <div class="max-w-4xl mx-auto">
          <div class="mb-16">
            <QuickInfoBar
              duration={duration}
              groupSize={groupSize}
              price={price}
              accentColor={accentColor}
            />
          </div>

          <h2 class="text-3xl md:text-4xl lg:text-5xl text-center mb-12 leading-tight text-brand-text">
            Resumen de la Expedición
          </h2>

          <div class="prose prose-lg prose-slate prose-invert mx-auto text-center">
            <div class="text-lg leading-relaxed text-brand-text">
              <p>{expeditionSummary}</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <TravelMapSummary itineraryDays={itineraryDays} accentColor={accentColor} />

    <ItinerarySection
      itineraryDays={itineraryDays}
      placeholderImage={islandiaPoster}
    />
  </main>
</Layout>