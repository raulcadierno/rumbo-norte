---
import { getEntry, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import TravelHero from '../../components/travel/TravelHero.astro';
import QuickInfoBar from '../../components/travel/QuickInfoBar.astro';
import TravelImageGallery from '../../components/travel/TravelImageGallery.astro';
import TravelMapSummary from '../../components/travel/TravelMapSummary.astro';
import ItinerarySection from '../../components/travel/ItinerarySection.astro';
import islandiaPoster from '../../assets/viajes/islandia/islandia.jpg';
import islandiaVid from '../../assets/viajes/islandia/islandia-vid.webm';
import islGallery1 from '../../assets/viajes/islandia/isl-gallery-1.jpg';
import islGallery2 from '../../assets/viajes/islandia/isl-gallery-2.jpg';
import islGallery3 from '../../assets/viajes/islandia/isl-gallery-3.jpg';
import islGallery4 from '../../assets/viajes/islandia/isl-gallery-4.jpg';
import islGallery5 from '../../assets/viajes/islandia/isl-gallery-5.jpg';
import islGallery6 from '../../assets/viajes/islandia/isl-gallery-6.jpg';
import { getTravelData } from '../../utils/itineraryHelper';

const viaje = await getEntry('viajes', 'islandia');

if (!viaje) {
  throw new Error('No se encontro la entrada de Islandia en la coleccion viajes.');
}

const {
  title,
  subtitle,
  description,
  duration,
  groupSize,
  price,
  primaryColor = '#1B263B',
  backgroundColor = '#101729',
  secondaryColor = '#1E293B',
  ctaButtonColor = '#155DFC',
  linkHoverColor = '#F97316',
  textColor = '#E2E8F0'
} = viaje.data;

const safeBackgroundColor = backgroundColor.startsWith('#') ? backgroundColor : `#${backgroundColor}`;
const accentColor = ctaButtonColor?.trim() || '#C4A484';
const { itineraryDays } = getTravelData(viaje);
const { Content } = await render(viaje);

const galleryImages = [
  { src: islGallery1.src, alt: 'Volcanes activos en las tierras altas de Islandia' },
  { src: islGallery2.src, alt: 'Cascadas glaciares al amanecer en la costa sur' },
  { src: islGallery3.src, alt: 'Aurora boreal sobre campos de lava negra' },
  { src: islGallery4.src, alt: 'Fiordos del este con montanas nevadas' },
  { src: islGallery5.src, alt: 'Laguna glaciar con icebergs a la deriva' },
  { src: islGallery6.src, alt: 'Ruta artica entre geiseres y mesetas volcanicas' }
];
---

<Layout title={`${title} | Nomad Expeditions`} description={description}>
  <main
    style={`--color-primary: ${primaryColor}; --color-bg: ${safeBackgroundColor}; --color-secondary: ${secondaryColor}; --color-cta: ${accentColor}; --color-link-hover: ${linkHoverColor}; --color-text: ${textColor};`}
  >
    <TravelHero
      title={title}
      subtitle={subtitle}
      description={description}
      image={islandiaPoster}
      videoSrc={islandiaVid}
      posterSrc={islandiaPoster.src}
      accentColor={accentColor}
    />

    <section class="relative py-20 bg-brand-bg">
      <div class="container mx-auto px-4">
        <div class="max-w-4xl mx-auto">
          <div class="mb-16">
            <QuickInfoBar
              duration={duration}
              groupSize={groupSize}
              price={price}
              accentColor={accentColor}
            />
          </div>

          <h2 class="text-3xl md:text-4xl lg:text-5xl text-center mb-12 leading-tight text-brand-text">
            Resumen de la Expedicion
          </h2>

          <div class="summary-content prose prose-lg prose-slate prose-invert mx-auto text-center text-brand-text">
            <Content />
          </div>
        </div>
      </div>

    </section>

    <TravelMapSummary itineraryDays={itineraryDays} accentColor={accentColor} />

    <ItinerarySection
      itineraryDays={itineraryDays}
      placeholderImage={islandiaPoster}
    />

    <TravelImageGallery images={galleryImages} />
    
  </main>

  <style>
    .summary-content :global(h3),
    .summary-content :global(h3 ~ *) {
      display: none;
    }

    .summary-content :global(p) {
      color: var(--color-text);
      line-height: 1.75;
    }
  </style>
</Layout>
