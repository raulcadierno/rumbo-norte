---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import DestinationsGrid from '../components/DestinationsGrid.astro';
import Features from '../components/Features.astro';
import AboutUs from '../components/AboutUs.astro';
---

<Layout title="Nomad Expeditions - Inicio">
  <!-- Hero Section -->
  <Hero />

  <!-- Destinations Grid Section -->
  <section id="destinos">
    <DestinationsGrid />
  </section>

  <!-- Features Section -->
  <section id="aventuras">
    <Features />
  </section>

  <!-- About Us Section -->
  <section id="nosotros">
    <AboutUs />
  </section>

  <!-- Contact Anchor Section -->
  <section id="contacto" class="bg-slate-950 py-16"></section>
	
</Layout>
