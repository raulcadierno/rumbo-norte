---
// Layout.astro - Layout base del sitio  
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import { ClientRouter as ViewTransitions } from 'astro:transitions';
import '../styles/global.css';
import '@fontsource/syne/500.css'; // Importamos el peso "Extra Bold" para los títulos
import '@fontsource-variable/plus-jakarta-sans/index.css'; // Importa automáticamente todos los pesos

export interface Props {
  title?: string;
  description?: string;
}

const { title = "Nomad Expeditions", description = "Aventuras únicas alrededor del mundo" } = Astro.props;
---

<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <ViewTransitions />
    <title>{title}</title>
  </head>
  <body class="bg-nomad-bg text-nomad-text-main font-sans">
    <!-- Navigation Component -->
    <Navbar />
    
    <!-- Main Content -->
    <main>
      <slot />
    </main>

    <Footer />
  </body>
</html>